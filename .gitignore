# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/wear/build/
/android/local.properties
/android/*.iml
/android/.idea/
android/.cxx/
*.apk
*.aab

# Native libs: ignore stray .so everywhere EXCEPT the checked-in
# release libraries under android/app/src/main/jniLibs (bitchat-style
# prebuilt native pipeline — integrity pinned by tools/native-SHA256SUMS).
*.so
!android/app/src/main/jniLibs/**/*.so

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Secrets — NEVER commit tokens/keys
.env
*.pem
*.keystore
!debug.keystore
secrets/

# OS
Thumbs.db
