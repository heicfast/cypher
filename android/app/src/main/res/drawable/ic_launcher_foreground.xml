<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Interlocking two-link chain tilted at -45 deg matching Cipher brand mark -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-38">
        <!-- Left chain link -->
        <path
            android:pathData="M48,43 H37 A11,11 0 0,0 37,65 H50"
            android:strokeWidth="6.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="26"
                    android:startY="43"
                    android:endX="54"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#E0C3FC" />
                    <item android:offset="1.0" android:color="#9D7BFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Right chain link -->
        <path
            android:pathData="M60,65 H71 A11,11 0 0,0 71,43 H58"
            android:strokeWidth="6.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="54"
                    android:startY="43"
                    android:endX="82"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#D8B4FE" />
                    <item android:offset="1.0" android:color="#A855F7" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Center interlocking bridge -->
        <path
            android:pathData="M45,54 H63"
            android:strokeWidth="6.8"
            android:strokeLineCap="round"
            android:strokeColor="#D8B4FE" />
    </group>
</vector>
